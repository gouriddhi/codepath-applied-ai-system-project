flowchart TD
    %% PawPal+ with RAG care assistant

    subgraph INPUT [1. Input]
        U([Pet owner]) -->|"pet info: species, age, special needs"| UI["Streamlit UI - app.py"]
    end

    subgraph PROCESS [2. Process - care_assistant.py]
        R["Retriever: finds matching care notes"]
        KB[("knowledge/ pet-care notes")]
        LLM["Gemini API: suggests care tasks"]
        G["Guardrails: validate priority, duration, category"]
        R <--> KB
        R -->|"notes + pet info"| LLM
        LLM -->|"tasks as JSON"| G
    end

    subgraph HUMAN [3. Human check]
        H{"Owner reviews suggestions"}
    end

    subgraph OUTPUT [4. Output - pawpal_system.py]
        S["Scheduler: builds daily plan, flags conflicts"]
        PLAN["Daily care plan shown in UI"]
        S --> PLAN
    end

    subgraph TESTING [Testing and monitoring]
        T1["pytest: guardrail + scheduler tests"]
        T2["eval script: runs sample pets, checks AI output"]
        LOG[("logs/pawpal.log")]
    end

    UI --> R
    G -->|"valid tasks"| H
    G -.->|"rejected tasks / API errors"| LOG
    H -->|"approve"| S
    H -->|"reject"| LOG
    PLAN --> U

    T1 -.->|checks| G
    T1 -.->|checks| S
    T2 -.->|checks| LLM
